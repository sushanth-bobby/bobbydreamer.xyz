{
  "name": "@bdv/quartz-content-context",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "..\\node_modules\\.bin\\esbuild.cmd index.ts components.tsx --bundle --platform=node --format=esm --outdir=dist --external:preact* --external:@quartz-community/*"
  },
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "quartz": {
    "name": "quartz-content-context",
    "displayName": "Article context",
    "category": "component",
    "version": "1.0.0",
    "components": {
      "ArticleContext": {
        "displayName": "Article context",
        "defaultPosition": "beforeBody",
        "defaultPriority": 25
      }
    }
  }
}
