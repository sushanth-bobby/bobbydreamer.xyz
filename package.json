{
  "name": "@jackyzha0/quartz",
  "description": "🌱 publish your digital garden and notes as a website",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "author": "jackyzha0 <j.zhao2k19@gmail.com>",
  "license": "MIT",
  "homepage": "https://quartz.jzhao.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackyzha0/quartz.git"
  },
  "scripts": {
    "quartz": "node ./quartz/bootstrap-cli.mjs",
    "build": "node ./quartz/bootstrap-cli.mjs build && npm run finalize:production",
    "serve": "node ./quartz/bootstrap-cli.mjs build --serve",
    "docs": "node ./quartz/bootstrap-cli.mjs build --serve -d docs",
    "check": "tsc --noEmit && npx prettier . --check",
    "format": "npx prettier . --write",
    "test": "tsx --test",
    "validate:customizations": "node ./scripts/validate-customizations.mjs",
    "validate:upgrade": "npm run validate:customizations && npm test && npm run check && npm run validate:packages && npm run validate:content && npm run media:verify && npm run build && npm run validate:production && npm run validate:cache && npm run validate:media",
    "validate:upgrade:served": "npm run validate:caddy",
    "validate:packages": "node ./scripts/validate-local-packages.mjs",
    "validate:content": "node ./scripts/audit-content.mjs --as-of 2026-09-29",
    "finalize:production": "node --import tsx ./scripts/finalize-production.ts",
    "validate:production": "node ./scripts/validate-production.mjs",
    "validate:cache": "node ./scripts/validate-cache-contract.mjs",
    "media:audit": "node ./scripts/media/cli.mjs audit",
    "media:build": "node ./scripts/media/cli.mjs build",
    "media:verify": "node ./scripts/media/cli.mjs verify",
    "media:clean": "node ./scripts/media/cli.mjs clean",
    "media:stats": "node ./scripts/media/cli.mjs stats",
    "media:benchmark:change": "node ./scripts/media/benchmark-change.mjs",
    "test:media": "node --test ./scripts/media/media.test.mjs",
    "validate:media": "node ./scripts/validate-media-output.mjs",
    "validate:caddy": "node ./scripts/validate-caddy.mjs",
    "validate:live": "node ./scripts/validate-live-release.mjs",
    "deploy:check": "node ./scripts/deploy-production.mjs check",
    "deploy:production": "node ./scripts/deploy-production.mjs production",
    "profile": "0x -D prof ./quartz/bootstrap-cli.mjs build --concurrency=1",
    "install-plugins": "npx tsx ./quartz/plugins/loader/install-plugins.ts",
    "prebuild": "npm run media:build && npm --prefix quartz-media run build && npm run install-plugins",
    "preserve": "npm run media:build && npm --prefix quartz-media run build && npm run install-plugins"
  },
  "engines": {
    "npm": ">=10.9.2",
    "node": ">=22"
  },
  "keywords": [
    "site generator",
    "ssg",
    "digital-garden",
    "markdown",
    "blog",
    "quartz"
  ],
  "bin": {
    "quartz": "./quartz/bootstrap-cli.mjs"
  },
  "dependencies": {
    "@bdv/quartz-content-context": "file:./quartz-content-context",
    "@bdv/quartz-ia-article-nav": "file:./quartz-ia-article-nav",
    "@bdv/quartz-ia-articles": "file:./quartz-ia-articles",
    "@bdv/quartz-ia-header": "file:./quartz-ia-header",
    "@bdv/quartz-ia-pages": "file:./quartz-ia-pages",
    "@bdv/quartz-ia-properties": "file:quartz-ia-properties",
    "@bdv/quartz-media": "file:./quartz-media",
    "@clack/prompts": "^1.8.0",
    "@floating-ui/dom": "^1.7.4",
    "@myriaddreamin/rehype-typst": "^0.7.0",
